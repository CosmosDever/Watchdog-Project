#!/bin/bash
# web-recon <url> — deterministic first-pass recon for an AUTHORIZED web target.
# Fingerprints the app and extracts the REAL /api and /rest routes from its JavaScript
# bundles (single-page apps hide them there, not at guessable URLs), so the agent gets a
# complete endpoint map without guessing. Saves ./report/recon_map.md when a report folder
# exists. For authorized testing of targets in your engagement scope only.
set -uo pipefail

[ $# -ge 1 ] || { echo "Usage: web-recon <url>   e.g. web-recon http://127.0.0.1:42000"; exit 1; }
URL="${1%/}"
UA="watchdog-web-recon"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

echo "# Recon map — $URL"
echo

echo "## Response headers"
echo '```'
curl -s -A "$UA" -I "$URL/" 2>/dev/null | sed 's/\r$//'
echo '```'

if command -v whatweb >/dev/null 2>&1; then
    echo
    echo "## whatweb"
    echo '```'
    whatweb -a 1 "$URL/" 2>/dev/null | sed -E 's/\x1b\[[0-9;]*m//g'
    echo '```'
fi

echo
echo "## robots.txt"
echo '```'
curl -s -A "$UA" "$URL/robots.txt" 2>/dev/null | head -n 40
echo '```'

echo
echo "## Quick path probe"
for p in ftp sitemap.xml .git/HEAD api rest metrics snippets; do
    code=$(curl -s -A "$UA" -o /dev/null -w '%{http_code}' "$URL/$p" 2>/dev/null)
    echo "  $URL/$p -> $code"
done

echo
echo "## API / REST routes extracted from JavaScript bundles"
HOME_HTML="$(curl -s -A "$UA" "$URL/" 2>/dev/null)"
JS=$(printf '%s' "$HOME_HTML" | grep -oE '(src|href)="[^"]+\.js"' | sed -E 's/.*="([^"]+)".*/\1/' | sort -u)
[ -z "$JS" ] && JS="main.js runtime.js polyfills.js vendor.js scripts.js"
ROUTES="$TMP/routes.txt"
: > "$ROUTES"
for j in $JS; do
    case "$j" in
        http*) u="$j" ;;
        /*)    u="$URL$j" ;;
        *)     u="$URL/$j" ;;
    esac
    curl -s -A "$UA" "$u" 2>/dev/null | grep -oE '/(api|rest)/[A-Za-z0-9/_.:?=-]+' >> "$ROUTES"
done
sort -u "$ROUTES" | sed 's/^/  /'
COUNT=$(sort -u "$ROUTES" | grep -c . || true)
echo
echo "($COUNT unique routes found)"
if [ "$COUNT" -eq 0 ]; then
    echo "  (none found automatically — list the bundles with: curl -s $URL/ | grep -oE '[^\" ]+\\.js')"
fi

if [ -d "./report" ]; then
    {
        echo "# Recon map — $URL"
        echo "_generated by web-recon on $(date)_"
        echo
        echo "## API / REST routes"
        sort -u "$ROUTES" | sed 's/^/- /'
    } > ./report/recon_map.md
    echo
    echo "Saved route list to ./report/recon_map.md"
fi
