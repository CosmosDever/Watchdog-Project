# Hodophylax never commits large downloaded artifacts — the provisioner fetches them.
# Models (multi-GB GGUF)
*.gguf
# VM disk images and firmware
*.qcow2
*.img
*.iso
*.7z
*.fd
# Downloaded runtimes (QEMU, llama.cpp, Python, SPICE viewer)
drive/runtime/
drive/llm/runtime/
drive/llm/models/
drive/vm/
drive/_downloads/
# Downloaded artifacts never belong in git (the provisioner fetches them)
# Engagement data must never leave the operator's machine
engagement/
**/scope.md
# Python bytecode
__pycache__/
*.pyc
# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
*.log
*.tmp
